{
  "manifest_version": 3,
  "name": "My Mysore Blog Draft Helper",
  "version": "0.6.3",
  "description": "One-click loading and input of approved yoga posts from GitHub into Naver Blog.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "debugger",
    "alarms",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://blog.naver.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/my-mysore/*"
      ],
      "js": [
        "publish-success.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
