{
  "manifest_version": 3,
  "name": "My Mysore Blog Draft Helper",
  "version": "0.5.0",
  "description": "Load approved yoga posts and fill Naver SmartEditor using browser-level text input.",
  "permissions": [
    "clipboardWrite",
    "alarms",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "debugger"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://blog.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
