{
  "manifest_version": 3,
  "name": "My Mysore Blog Draft Helper",
  "version": "0.4.0",
  "description": "Watch GitHub for approved yoga posts and prepare them for safe manual paste into Naver Blog.",
  "permissions": [
    "clipboardWrite",
    "alarms",
    "storage",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://blog.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}